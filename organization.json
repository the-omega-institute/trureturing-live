{
  "schema": "ai-org.config.v1",
  "organization": {
    "id": "trureturing",
    "label": "trureturing AI 数学研究院"
  },
  "departments": [
    {
      "id": "direction",
      "label": "研究方向",
      "responsibility": "人提出问题、确定方向，并在研究过程中给出判断与修正。",
      "execution": "human"
    },
    {
      "id": "research",
      "label": "数学攻坚",
      "responsibility": "认领课题，探索证明与反例，把可以检验的论证提交给共同研究。",
      "execution": "sessions"
    },
    {
      "id": "review",
      "label": "独立评审",
      "responsibility": "从新的视角检查论证、边界与适用范围，将意见送回研究者。",
      "execution": "sessions"
    },
    {
      "id": "verification",
      "label": "形式验证",
      "responsibility": "全院形式化真理枢纽：承接来自数学攻坚、理论书写、论文评议与外部合作的形式化验证请求，通过 Lean 内核与 CI 固化可复用定理，并将结果与障碍回流各部门。",
      "execution": "actions"
    },
    {
      "id": "books",
      "label": "理论书写",
      "responsibility": "将已验证定理整理为双语章节并持续构建出版，同时将书稿中的书面证明与缺口转化为新的形式化验证请求。",
      "execution": "mixed"
    },
    {
      "id": "publication",
      "label": "论文与知识",
      "responsibility": "发布已验证研究的短文、DOI、公开论文与评议目录，并为论文与猜想生成新的 Lean 验证目标。",
      "execution": "mixed"
    },
    {
      "id": "outreach",
      "label": "学术交流",
      "responsibility": "协调学术通信与外部学者合作，将合作回复与问题缺口既送回研究方向，也直接生成公开的形式化验证请求。",
      "execution": "actions"
    },
    {
      "id": "studio",
      "label": "工具与表达",
      "responsibility": "维护研究工具、出版模板、可视化和影像，让组织的成果可以被理解与使用。",
      "execution": "mixed"
    }
  ],
